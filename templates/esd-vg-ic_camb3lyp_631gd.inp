# LSH-33 ESD(IC) | CAM-B3LYP/6-31G(d) | VG default | ORCA 6.1
! CAM-B3LYP RIJCOSX 6-31G(d) CPCM(Methanol) ESD(IC) TightScf

%maxcore 3072

%pal
   nprocs 16
end

%tddft
  nroots 5
  iroot 1
  nacme true
  etf   true
  tda   true
end

%esd
  gshessian "LSH-33.hess"
  eshessian "LSH-33.hess"
  usej true
end
