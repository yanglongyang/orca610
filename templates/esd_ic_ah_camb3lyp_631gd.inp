#===============================================================================
# @TYPE:       esd-ic-ah
# @FUNCTIONAL: CAM-B3LYP
# @BASIS:      6-31G(d)
# @SOLVENT:    CPCM(Methanol)
# @DISPERSION: D3BJ
# @TDA:        false
# @ORCA:       6.1.x
# @CHARGE:     <CHARGE>
# @MULT:       <MULT>
# @STATUS:     PENDING
#===============================================================================
# ORCA 6.1 manual, Sec. 5.5.5:
# - full TD-DFT is recommended for NACME
# - provide ground- and excited-state Hessians
# - input geometry must match the ground-state Hessian
#===============================================================================

! CAM-B3LYP RIJCOSX 6-31G(d) D3BJ CPCM(Methanol) ESD(IC) TightScf

%maxcore <MAXCORE_MB_PER_CORE>
%pal nprocs <NPROCS> end

%tddft
  tda false
  nroots 5
  iroot 1
  nacme true
  etf true
end

%esd
  gshessian "<S0_HESSIAN>"
  eshessian "<S1_HESSIAN>"
  usej true
end

* xyz <CHARGE> <MULT>
  <INSERT S0 GEOMETRY MATCHING GSHESSIAN>
*
